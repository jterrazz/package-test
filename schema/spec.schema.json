{
    "$defs": {
        "fileAssertion": {
            "oneOf": [
                {
                    "enum": [
                        "absent",
                        "exists"
                    ],
                    "type": "string"
                },
                {
                    "allOf": [
                        {
                            "anyOf": [
                                {
                                    "required": [
                                        "contains"
                                    ]
                                },
                                {
                                    "required": [
                                        "equals"
                                    ]
                                }
                            ]
                        }
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "contains": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "items": {
                                        "type": "string"
                                    },
                                    "minItems": 1,
                                    "type": "array"
                                }
                            ]
                        },
                        "equals": {
                            "type": "string"
                        }
                    },
                    "type": "object"
                }
            ]
        },
        "capture": {
            "additionalProperties": {
                "pattern": "^\\$",
                "type": "string"
            },
            "description": "Name → the JSONPath of the response body it reads ($.id, $.items[0].name); a later step sends it as {{name}}.",
            "propertyNames": {
                "not": {
                    "enum": [
                        "any",
                        "base64",
                        "date",
                        "duration",
                        "email",
                        "float",
                        "hex",
                        "int",
                        "ip",
                        "iso8601",
                        "number",
                        "path",
                        "port",
                        "semver",
                        "sha",
                        "string",
                        "time",
                        "ulid",
                        "url",
                        "uuid",
                        "workdir"
                    ]
                },
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "type": "object"
        },
        "request": {
            "description": "A ./requests/<name>.http sent whole, or an inline request line — METHOD /path, {{capture}} references allowed.",
            "oneOf": [
                {
                    "pattern": "^\\.\\.?/(?:(?!(?:expected|fixtures|requests|seeds)/)[^/]+/)*?requests/[^/].*\\.http$",
                    "type": "string"
                },
                {
                    "pattern": "^(?:GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS) /",
                    "type": "string"
                }
            ]
        },
        "response": {
            "description": "A ./expected/<name>.http golden, or its three parts inline — status, a subset of headers, the body — each token-aware.",
            "oneOf": [
                {
                    "pattern": "^\\.\\.?/(?:(?!(?:expected|fixtures|requests|seeds)/)[^/]+/)*?expected/[^/].*\\.http$",
                    "type": "string"
                },
                {
                    "allOf": [
                        {
                            "anyOf": [
                                {
                                    "required": [
                                        "status"
                                    ]
                                },
                                {
                                    "required": [
                                        "headers"
                                    ]
                                },
                                {
                                    "required": [
                                        "body"
                                    ]
                                }
                            ]
                        }
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "body": {
                            "description": "The body, compared structurally."
                        },
                        "headers": {
                            "additionalProperties": {
                                "type": "string"
                            },
                            "type": "object"
                        },
                        "status": {
                            "oneOf": [
                                {
                                    "type": "integer"
                                },
                                {
                                    "type": "string"
                                }
                            ]
                        }
                    },
                    "type": "object"
                }
            ]
        },
        "run": {
            "allOf": [
                {
                    "not": {
                        "required": [
                            "stdin",
                            "waitFor"
                        ]
                    }
                }
            ],
            "required": [
                "command",
                "exit"
            ],
            "additionalProperties": false,
            "properties": {
                "command": {
                    "description": "The argv line, run through the shell.",
                    "type": "string"
                },
                "exit": {
                    "description": "The exit code the command must return.",
                    "type": "integer"
                },
                "files": {
                    "additionalProperties": {
                        "$ref": "#/$defs/fileAssertion"
                    },
                    "description": "On-disk assertions, keyed by a path under the working directory.",
                    "type": "object"
                },
                "stderr": {
                    "description": "Expected stderr, byte-exact. Absent asserts an empty stream.",
                    "type": "string"
                },
                "stdin": {
                    "description": "Written to the child, then closed.",
                    "type": "string"
                },
                "stdout": {
                    "description": "Expected stdout, byte-exact. Absent asserts an empty stream.",
                    "type": "string"
                },
                "timeout": {
                    "description": "Milliseconds before the run is killed.",
                    "type": "integer"
                },
                "waitFor": {
                    "description": "Resolve when this text appears. Only on the last run.",
                    "type": "string"
                }
            },
            "type": "object"
        },
        "seedEntry": {
            "oneOf": [
                {
                    "pattern": "^\\.\\.?/(?:(?!(?:expected|fixtures|requests|seeds)/)[^/]+/)*?seeds/[^/].*\\.sql$",
                    "type": "string"
                },
                {
                    "required": [
                        "file"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "database": {
                            "type": "string"
                        },
                        "file": {
                            "pattern": "^\\.\\.?/(?:(?!(?:expected|fixtures|requests|seeds)/)[^/]+/)*?seeds/[^/].*\\.sql$",
                            "type": "string"
                        }
                    },
                    "type": "object"
                }
            ]
        },
        "step": {
            "required": [
                "request"
            ],
            "allOf": [
                {
                    "anyOf": [
                        {
                            "required": [
                                "response"
                            ]
                        },
                        {
                            "required": [
                                "tables"
                            ]
                        }
                    ]
                },
                {
                    "not": {
                        "properties": {
                            "request": {
                                "pattern": "^\\.\\.?/",
                                "type": "string"
                            }
                        },
                        "required": [
                            "request",
                            "body"
                        ]
                    }
                }
            ],
            "additionalProperties": false,
            "properties": {
                "body": {
                    "description": "The body an inline request sends: a value, or a file under requests/ named by its path."
                },
                "capture": {
                    "$ref": "#/$defs/capture"
                },
                "headers": {
                    "additionalProperties": {
                        "type": "string"
                    },
                    "type": "object"
                },
                "request": {
                    "$ref": "#/$defs/request"
                },
                "response": {
                    "$ref": "#/$defs/response"
                },
                "tables": {
                    "$ref": "#/$defs/tables"
                }
            },
            "type": "object"
        },
        "tables": {
            "additionalProperties": {
                "required": [
                    "columns",
                    "rows"
                ],
                "additionalProperties": false,
                "properties": {
                    "columns": {
                        "items": {
                            "type": "string"
                        },
                        "minItems": 1,
                        "type": "array"
                    },
                    "database": {
                        "type": "string"
                    },
                    "rows": {
                        "items": {
                            "type": "array"
                        },
                        "type": "array"
                    }
                },
                "type": "object"
            },
            "description": "Table name → the rows it holds after the action, in order, as toMatchRows() takes them; rows: [] asserts it is empty.",
            "type": "object"
        },
        "serveEntry": {
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "additionalProperties": {
                        "additionalProperties": {
                            "type": "string"
                        },
                        "type": "object"
                    },
                    "maxProperties": 1,
                    "minProperties": 1,
                    "type": "object"
                }
            ]
        }
    },
    "$id": "https://jterrazz.com/schema/jterrazz-test/spec.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "allOf": [
        {
            "if": {
                "anyOf": [
                    {
                        "not": {
                            "required": [
                                "kind"
                            ]
                        }
                    },
                    {
                        "properties": {
                            "kind": {
                                "const": "cli"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    }
                ]
            },
            "then": {
                "required": [
                    "runs"
                ],
                "propertyNames": {
                    "enum": [
                        "kind",
                        "description",
                        "fixture",
                        "env",
                        "serve",
                        "runs"
                    ]
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "api"
                    }
                },
                "required": [
                    "kind"
                ]
            },
            "then": {
                "allOf": [
                    {
                        "anyOf": [
                            {
                                "required": [
                                    "request"
                                ]
                            },
                            {
                                "required": [
                                    "steps"
                                ]
                            }
                        ]
                    },
                    {
                        "not": {
                            "required": [
                                "steps",
                                "request"
                            ]
                        }
                    },
                    {
                        "not": {
                            "required": [
                                "steps",
                                "body"
                            ]
                        }
                    },
                    {
                        "not": {
                            "required": [
                                "steps",
                                "response"
                            ]
                        }
                    },
                    {
                        "not": {
                            "required": [
                                "steps",
                                "tables"
                            ]
                        }
                    }
                ],
                "dependentSchemas": {
                    "request": {
                        "required": [
                            "request"
                        ],
                        "allOf": [
                            {
                                "anyOf": [
                                    {
                                        "required": [
                                            "response"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "tables"
                                        ]
                                    }
                                ]
                            },
                            {
                                "not": {
                                    "properties": {
                                        "request": {
                                            "pattern": "^\\.\\.?/",
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "request",
                                        "body"
                                    ]
                                }
                            }
                        ]
                    }
                },
                "propertyNames": {
                    "enum": [
                        "kind",
                        "description",
                        "seed",
                        "intercept",
                        "clock",
                        "headers",
                        "request",
                        "body",
                        "response",
                        "tables",
                        "steps"
                    ]
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "jobs"
                    }
                },
                "required": [
                    "kind"
                ]
            },
            "then": {
                "allOf": [
                    {
                        "anyOf": [
                            {
                                "required": [
                                    "tables"
                                ]
                            },
                            {
                                "required": [
                                    "error"
                                ]
                            }
                        ]
                    }
                ],
                "required": [
                    "trigger"
                ],
                "propertyNames": {
                    "enum": [
                        "kind",
                        "description",
                        "seed",
                        "intercept",
                        "clock",
                        "trigger",
                        "error",
                        "tables"
                    ]
                }
            }
        }
    ],
    "description": "One case of the @jterrazz/test literate format, one file per test: the ground it stands on, what it does, and what came back.",
    "properties": {
        "body": {
            "description": "api: the body an inline request sends — a value, or a file under requests/ named by its path."
        },
        "clock": {
            "description": "api, jobs: the instant the chain's .clock() pins, ISO — 2026-03-04T09:30:00Z.",
            "type": "string"
        },
        "description": {
            "description": "The vitest test title — one lowercase line, no trailing period.",
            "type": "string"
        },
        "error": {
            "description": "jobs: the message the triggered job must reject with, token-aware; absent asserts it succeeded.",
            "type": "string"
        },
        "headers": {
            "additionalProperties": {
                "type": "string"
            },
            "type": "object",
            "description": "api: the headers every request of the document carries."
        },
        "intercept": {
            "oneOf": [
                {
                    "pattern": "^\\.\\.?/(?:(?!(?:expected|fixtures|requests|seeds)/)[^/]+/)*?contracts/(?:(?!(?:expected|fixtures|requests|seeds)/)[^/]+/)*[^/]+$",
                    "type": "string"
                },
                {
                    "items": {
                        "pattern": "^\\.\\.?/(?:(?!(?:expected|fixtures|requests|seeds)/)[^/]+/)*?contracts/(?:(?!(?:expected|fixtures|requests|seeds)/)[^/]+/)*[^/]+$",
                        "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                }
            ],
            "description": "api, jobs: contract modules under contracts/, each default-exporting a contract, a list or a composite — applied in order."
        },
        "request": {
            "$ref": "#/$defs/request"
        },
        "response": {
            "$ref": "#/$defs/response"
        },
        "seed": {
            "description": "api, jobs: .sql files under seeds/, applied in order — { file, database } targets one database when several are declared.",
            "oneOf": [
                {
                    "$ref": "#/$defs/seedEntry"
                },
                {
                    "items": {
                        "$ref": "#/$defs/seedEntry"
                    },
                    "minItems": 1,
                    "type": "array"
                }
            ]
        },
        "steps": {
            "description": "api: a journey — each step a request and what came back, sending what earlier steps captured.",
            "items": {
                "$ref": "#/$defs/step"
            },
            "minItems": 1,
            "type": "array"
        },
        "tables": {
            "$ref": "#/$defs/tables"
        },
        "trigger": {
            "description": "jobs: the registered job the case runs.",
            "type": "string"
        },
        "env": {
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                }
            ],
            "description": "A bare word names an env set registered in code; KEY=value is inline. $WORKDIR expands."
        },
        "fixture": {
            "description": "Fixture paths copied into the working directory, layering in order — each relative to this document (`./…`, `../…`), in the two forms the chain's `file()` and `directory()` take: a trailing `/` names a directory whose contents are spread, without it one file is copied under its own name. The first ground folder a path passes through is fixtures/ — ./fixtures/ beside the document, or specs/fixtures/ reached by the path that climbs to it.",
            "oneOf": [
                {
                    "pattern": "^\\.\\.?/(?:(?!(?:expected|fixtures|requests|seeds)/)[^/]+/)*?fixtures/.*$",
                    "type": "string"
                },
                {
                    "items": {
                        "pattern": "^\\.\\.?/(?:(?!(?:expected|fixtures|requests|seeds)/)[^/]+/)*?fixtures/.*$",
                        "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                }
            ]
        },
        "kind": {
            "default": "cli",
            "description": "The facet this document describes.",
            "enum": [
                "cli",
                "api",
                "jobs"
            ],
            "type": "string"
        },
        "runs": {
            "description": "The session: one or more runs, sequential, sharing one working directory.",
            "items": {
                "$ref": "#/$defs/run"
            },
            "minItems": 1,
            "type": "array"
        },
        "serve": {
            "description": "Servers registered in code, started once per file.",
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "items": {
                        "$ref": "#/$defs/serveEntry"
                    },
                    "minItems": 1,
                    "type": "array"
                }
            ]
        }
    },
    "required": [
        "description"
    ],
    "title": "@jterrazz/test spec document",
    "type": "object"
}
