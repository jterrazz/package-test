{
    "name": "@jterrazz/test",
    "version": "17.0.0",
    "description": "Declarative testing framework for HTTP APIs, CLIs, background jobs, websites, mobile apps and rendered components — one entry point, real infrastructure and a real browser, golden-file assertions, plus an oxlint convention plugin.",
    "keywords": [
        "api-testing",
        "browser-mode",
        "cli-testing",
        "component-testing",
        "e2e",
        "golden-files",
        "hexagonal",
        "integration-testing",
        "msw",
        "oxlint",
        "test-framework",
        "testcontainers",
        "testing",
        "vitest",
        "website-testing"
    ],
    "license": "MIT",
    "author": "Jean-Baptiste Terrazzoni <contact@jterrazz.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/jterrazz/package-test"
    },
    "bin": {
        "jterrazz-test-check": "dist/checker.js"
    },
    "files": [
        "dist",
        "!dist/catalogue.*",
        "!dist/coverage.*",
        "!dist/matrix.*",
        "!dist/route-split.*",
        "!dist/self-*",
        "!dist/vitest-browser.adapter.*",
        "!dist/**/*.map",
        "docs",
        "!docs/03-testing.md",
        "!docs/decisions",
        "schema"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "browser": "./dist/browser/index.js",
            "import": "./dist/index.js"
        },
        "./vitest": {
            "types": "./dist/vitest.d.ts",
            "import": "./dist/vitest.js"
        },
        "./oxlint": {
            "import": {
                "types": "./dist/oxlint.d.ts",
                "default": "./dist/oxlint.js"
            },
            "require": {
                "types": "./dist/oxlint.d.cts",
                "default": "./dist/oxlint.cjs"
            }
        },
        "./schema": "./schema/spec.schema.json"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "tsdown --config tsdown.config.ts",
        "build:cached": "rm -rf dist && TURBO_TELEMETRY_DISABLED=1 turbo run build --output-logs=new-only",
        "docs": "npm run build:cached && node dist/catalogue.js",
        "lint": "typescript check && node dist/checker.js && node dist/self-checker.js",
        "test": "vitest --run",
        "coverage": "npm run build:cached && vitest --run --coverage && node dist/coverage.js --write",
        "coverage:check": "node dist/coverage.js",
        "test:repeat": "vitest --run --repeats 10"
    },
    "dependencies": {
        "@oxlint/plugins": "^1.85.0",
        "msw": "^2.15.0",
        "oxc-parser": "^0.150.0",
        "vitest-mock-extended": "^5.0.0",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@hono/node-server": "^2.1.1",
        "@jterrazz/typescript": "file:../package-typescript",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.6.2",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/browser-playwright": "5.0.1",
        "@vitest/coverage-v8": "^5.0.1",
        "ajv": "^8.20.0",
        "better-sqlite3": "^13.0.3",
        "hono": "^4.13.9",
        "oxlint": "^1.85.0",
        "pg": "^8.23.0",
        "playwright": "^1.63.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router": "^8.4.0",
        "redis": "^6.2.1",
        "testcontainers": "^12.1.0",
        "tsdown": "^0.23.0",
        "turbo": "^2.11.3",
        "vite": "^8.3.0",
        "vitest": "5.0.1",
        "vitest-browser-react": "^2.3.0",
        "webdriverio": "^9.32.0"
    },
    "peerDependencies": {
        "@jterrazz/typescript": "^11.0.0",
        "@vitest/browser-playwright": "*",
        "appium": "^3.0.0",
        "better-sqlite3": "^12.11.1 || ^13",
        "pg": "^8.22.0",
        "playwright": "^1.49.0",
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19",
        "redis": "^6.1.0",
        "testcontainers": "^12.0.4",
        "vite": "^6.4.0 || ^7 || ^8",
        "vitest": "^5",
        "vitest-browser-react": "^2.3.0",
        "webdriverio": "^9.30.0"
    },
    "peerDependenciesMeta": {
        "@vitest/browser-playwright": {
            "optional": true
        },
        "appium": {
            "optional": true
        },
        "better-sqlite3": {
            "optional": true
        },
        "pg": {
            "optional": true
        },
        "playwright": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "redis": {
            "optional": true
        },
        "testcontainers": {
            "optional": true
        },
        "vite": {
            "optional": true
        },
        "vitest-browser-react": {
            "optional": true
        },
        "webdriverio": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=24"
    }
}
