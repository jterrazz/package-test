{
    "name": "@jterrazz/test",
    "version": "15.1.1",
    "description": "Declarative testing framework for HTTP APIs, CLIs, and background jobs — one entry point, real infrastructure, golden-file assertions, plus an oxlint convention plugin.",
    "keywords": [
        "api-testing",
        "cli-testing",
        "e2e",
        "golden-files",
        "hexagonal",
        "integration-testing",
        "msw",
        "oxlint",
        "test-framework",
        "testcontainers",
        "testing",
        "vitest"
    ],
    "license": "MIT",
    "author": "Jean-Baptiste Terrazzoni <contact@jterrazz.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/jterrazz/package-test"
    },
    "bin": {
        "jterrazz-test-check": "dist/checker.js"
    },
    "files": [
        "dist",
        "!dist/catalog.*",
        "schema"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "browser": "./dist/browser/index.js",
            "import": "./dist/index.js"
        },
        "./vitest": {
            "types": "./dist/vitest.d.ts",
            "import": "./dist/vitest.js"
        },
        "./oxlint": {
            "import": {
                "types": "./dist/oxlint.d.ts",
                "default": "./dist/oxlint.js"
            },
            "require": {
                "types": "./dist/oxlint.d.cts",
                "default": "./dist/oxlint.cjs"
            }
        },
        "./schema": "./schema/spec.schema.json"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "tsdown --config tsdown.config.ts",
        "docs": "npm run build && node dist/catalog.js && typescript docs",
        "lint": "typescript check && node dist/checker.js specs",
        "lint:fix": "typescript fix && node dist/checker.js specs --fix",
        "test": "vitest --run"
    },
    "dependencies": {
        "better-sqlite3": "^12.11.1",
        "mockdate": "^3.0.5",
        "msw": "^2.15.0",
        "pg": "^8.22.0",
        "redis": "^6.1.0",
        "testcontainers": "^12.0.4",
        "vitest-mock-extended": "^5.0.0",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@hono/node-server": "^2.0.8",
        "@jterrazz/typescript": "^10.0.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^26.1.1",
        "@types/pg": "^8.20.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/browser-playwright": "^4.1.10",
        "hono": "^4.12.30",
        "playwright": "^1.49.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router": "^8.4.0",
        "tsdown": "^0.22.7",
        "vite": "^8.1.4",
        "vitest": "^4.1.10",
        "vitest-browser-react": "^2.3.0",
        "webdriverio": "^9.30.0"
    },
    "peerDependencies": {
        "@vitest/browser-playwright": "*",
        "appium": "^3.0.0",
        "playwright": "^1.49.0",
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19",
        "vite": "^6.4.0 || ^7 || ^8",
        "vitest": "^4.1.10 || ^5",
        "vitest-browser-react": "^2.3.0",
        "webdriverio": "^9.30.0"
    },
    "peerDependenciesMeta": {
        "@vitest/browser-playwright": {
            "optional": true
        },
        "appium": {
            "optional": true
        },
        "playwright": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "vite": {
            "optional": true
        },
        "vitest-browser-react": {
            "optional": true
        },
        "webdriverio": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=20"
    },
    "allowScripts": {
        "better-sqlite3@12.11.1": true
    }
}
