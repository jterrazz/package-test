{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "testRunner": "vitest",
    "vitest": {
        "configFile": "vitest.mutation-specs.config.ts",
        "related": false
    },
    "coverageAnalysis": "off",
    "mutate": [
        "src/**/*.ts",
        "lint/**/*.ts",
        "!**/*.test.ts",
        "!**/*.test-d.ts",
        "!**/*.fixtures.ts",
        "!**/_fixtures/**",
        "!**/_expected/**"
    ],
    "buildCommand": "npx tsdown --config tsdown.config.ts",
    "checkers": [],
    "disableTypeChecks": "{src,lint}/**/!(*.test-d).ts",
    "incremental": false,
    "reporters": ["clear-text", "json", "progress"],
    "jsonReporter": {
        "fileName": ".artifacts/stryker/specs-report.json"
    },
    "timeoutMS": 60000,
    "concurrency": 6,
    "inPlace": true,
    "tempDirName": ".artifacts/stryker/tmp",
    "ignoreStatic": false
}
