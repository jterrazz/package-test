#!/bin/sh
# The project's oxlint: the repository's own, which the checker spec names. It
# First lays down the project's configs — `.oxlintrc.json` at the root and
# `web/.oxlintrc.jsonc` — from files under names oxlint never discovers, so the
# Repository's own lint never takes this fixture's configs for nested ones.
root="$(cd "$(dirname "$0")/../.." && pwd)"
for config in oxlintrc.json web/oxlintrc.jsonc; do
    target="$root/$(dirname "$config")/.$(basename "$config")"
    [ -f "$target" ] || sed "s#JTERRAZZ_TEST_REPO#$JTERRAZZ_TEST_REPO#" "$root/$config" > "$target"
done
exec "$JTERRAZZ_TEST_REPO/node_modules/.bin/oxlint" "$@"
