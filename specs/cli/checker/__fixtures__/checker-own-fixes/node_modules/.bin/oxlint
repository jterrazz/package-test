#!/bin/sh
# The project's oxlint: the repository's own, which the checker spec names. It
# Reads the project's `oxlint.config.mjs` — a name oxlint never discovers, so the
# Repository's own lint never takes this fixture's config for a nested one.
case " $* " in
    *" -c "*) exec "$STUDIO_TEST_REPO/node_modules/.bin/oxlint" "$@" ;;
    *) exec "$STUDIO_TEST_REPO/node_modules/.bin/oxlint" -c oxlint.config.mjs "$@" ;;
esac
