{
    "categories": {
        "correctness": "off"
    },
    "jsPlugins": [
        "../../../../dist/oxlint.js",
        "../../../../dist/self-oxlint.js"
    ],
    "rules": {
        "jterrazz/runner-in-specification-file": "error",
        "jterrazz/no-unknown-constructor": "error",
        "jterrazz/no-runner-alias": "error",
        "jterrazz/cleanup-passed-to-after-all": "error",
        "jterrazz/no-redundant-root": "error",
        "jterrazz/when-between-given-and-then": "error",
        "jterrazz/marker-on-one-line": "error",
        "jterrazz/no-repeated-chain-setting": "error",
        "jterrazz/given-and-then-markers-present": "error",
        "jterrazz/no-redundant-service-url": "error",
        "jterrazz/trigger-name-in-kebab-case": "error",
        "jterrazz/cli-runs-the-product-binary": "error",
        "jterrazz/specs-at-declared-depth": "error",
        "jterrazz/stubs-imported-through-facade": "error",
        "jterrazz/stub-data-has-a-builder": "error",
        "jterrazz/request-file-extension-known": "error",
        "jterrazz/stubs-root-holds-facades-and-kinds": "error",
        "jterrazz/golden-path-has-extension": "error",
        "jterrazz/seeds-are-sql": "error",
        "jterrazz/verb-reads-its-ground-folder": "error",
        "jterrazz/paths-named-in-the-test": "error",
        "jterrazz/one-describe-per-file": "error",
        "jterrazz/spec-named-for-its-aspect": "error",
        "jterrazz/spec-file-within-line-limit": "error",
        "jterrazz/test-body-within-line-limit": "error",
        "jterrazz/result-compared-whole": "error",
        "jterrazz/expected-constant-shared": "error",
        "jterrazz/no-imported-expectation": "error",
        "jterrazz/negative-golden-frozen": "error",
        "jterrazz/no-status-only-test": "error",
        "jterrazz/no-sampled-value-in-expectation": "error",
        "jterrazz/no-sampled-value-in-test": "error",
        "jterrazz/no-double-only-assertion": "error",
        "jterrazz/no-existence-only-assertion": "error",
        "jterrazz/no-expect-in-a-loop": "error",
        "jterrazz/no-expect-outside-a-test": "error",
        "jterrazz/no-probe-cluster": "error",
        "jterrazz/no-transform-duplicating-tokens": "error",
        "jterrazz/no-raw-bypass": "error",
        "jterrazz/no-single-use-ref": "error",
        "jterrazz/vitest-config-from-define-spec-config": "error",
        "jterrazz/project-named-for-its-facet": "error",
        "jterrazz/no-simulated-dom": "error",
        "jterrazz/browser-project-from-component": "error",
        "jterrazz/include-points-at-a-folder": "error",
        "jterrazz/literate-specification-exists": "error",
        "jterrazz/no-raw-env-write": "error",
        "jterrazz/no-test-code-in-production": "error",
        "jterrazz/no-dom-in-module-test": "error",
        "jterrazz/test-beside-its-module": "error",
        "jterrazz/no-module-mock": "error",
        "jterrazz/no-sleep": "error",
        "jterrazz/given-in-the-test": "error",
        "jterrazz/no-expect-in-scenario": "error",
        "jterrazz/test-id-states-what-is-missing": "error",
        "jterrazz/scenario-ends-settled": "error",
        "jterrazz-self/facet-is-a-composition": "error"
    }
}
