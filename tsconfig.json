{
    "extends": "@jterrazz/typescript/tsconfig/node",
    "compilerOptions": {
        "paths": {
            "@jterrazz/test": ["./src/index.browser.ts"],
            "@jterrazz/test/services": ["./src/index.services.browser.ts"],
            "@jterrazz/test/stubs": ["./src/index.stubs.browser.ts"]
        }
    },
    "exclude": [
        "${configDir}/node_modules",
        "${configDir}/dist",
        "${configDir}/.artifacts",
        "${configDir}/**/__expected__",
        "${configDir}/**/__fixtures__",
        "${configDir}/**/__requests__",
        "${configDir}/**/__seeds__",
        "${configDir}/schema"
    ]
}
