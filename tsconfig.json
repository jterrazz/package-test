{
    "extends": "@jterrazz/typescript/tsconfig/node",
    "compilerOptions": {
        "jsx": "react-jsx",
        "paths": {
            "@jterrazz/test": ["./src/browser/index.ts"]
        }
    },
    "include": ["${configDir}/**/*.ts", "${configDir}/**/*.tsx", "${configDir}/**/*.js"],
    "exclude": [
        "${configDir}/node_modules",
        "${configDir}/dist",
        "${configDir}/.artifacts",
        "${configDir}/specs/**/fixtures",
        "${configDir}/specs/**/expected",
        "${configDir}/src/**/fixtures",
        "${configDir}/src/**/expected"
    ]
}
