{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "src/index.ts",
        "src/index.vitest.ts",
        "lint/index.oxlint.ts",
        "lint/self/rules/plugin.ts",
        "lint/index.checker.ts",
        "lint/index.config.ts",
        "lint/self/self-cli.ts",
        "src/facets/cli/documents/schema-cli.ts"
    ],
    // Knip's oxlint plugin reads `oxlint.config.ts` and asks this package to
    // Declare every lint plugin the composed rulebook names. They are
    // `@jterrazz/typescript`'s: this config composes its fragments and holds no
    // Opinion of its own about them (docs/06-setting-up.md § Turning the conventions on).
    "oxlint": false,
    // `make` is the system's, never a dependency: the Makefile's meta-test runs
    // It to prove what `fix` does when a fixer fails.
    "ignoreBinaries": ["make"]
}
