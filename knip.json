{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "src/index.ts",
        "src/runner/index.ts",
        "lint/plugin.ts",
        "lint/checker-cli.ts",
        "lint/self-checker-cli.ts",
        "lint/catalog-cli.ts",
        "lint/coverage-cli.ts"
    ],
    // Knip's oxlint plugin reads `oxlint.config.ts` and asks this package to
    // Declare every lint plugin the composed rulebook names. They are
    // `@jterrazz/typescript`'s: this config composes its fragments and holds no
    // Opinion of its own about them (docs/19-linting.md § Enabling the plugin).
    "oxlint": false,
    // `make` is the system's, never a dependency: the Makefile's meta-test runs
    // It to prove what `fix` does when a fixer fails.
    "ignoreBinaries": ["make"]
}
