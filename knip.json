{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "src/index.ts",
        "src/runner/index.ts",
        "src/lint/plugin.ts",
        "src/lint/checker-cli.ts",
        "src/lint/catalog-cli.ts",
        "src/lint/coverage-cli.ts"
    ],
    "ignore": ["specs/_fixtures/**"],
    // Knip's oxlint plugin reads `oxlint.config.ts` and asks this package to
    // Declare every lint plugin the composed rulebook names. They are
    // `@jterrazz/typescript`'s: this config composes its fragments and holds no
    // Opinion of its own about them (docs/19-linting.md § Enabling the plugin).
    "oxlint": false
}
